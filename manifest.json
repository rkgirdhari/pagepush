{
  "manifest_version": 3,
  "name": "Page Push \u2014 AI to Facebook, One Click",
  "short_name": "Page Push",
  "version": "0.1.0",
  "description": "Capture text and images from ChatGPT, Claude, Notion, or Canva and push them straight to your Facebook Page \u2014 formatted, previewed, and posted in one click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Page Push",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "alarms",
    "sidePanel",
    "identity",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://graph.facebook.com/*",
    "https://*.facebook.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://*.notion.so/*",
        "https://www.canva.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["src/content-scripts/site-adapters.js", "src/content-scripts/inject-button.js"],
      "css": ["src/content-scripts/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; connect-src https://graph.facebook.com https://*.facebook.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline';"
  }
}
