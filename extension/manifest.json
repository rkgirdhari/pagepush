{
  "manifest_version": 3,
  "name": "Page Push — HCC",
  "short_name": "Page Push",
  "version": "1.0.0",
  "description": "Sovereign, local-first AI co-pilot for setting up and running your Facebook Business Page. Interview-driven Question & Do wizard, semantic DOM automation, and an optional local Rust/Candle Qwen3 bridge. No cloud required.",
  "author": "Hammurabi Coding Company, LLC",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.business.facebook.com/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Page Push"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.business.facebook.com/*"
      ],
      "js": ["content_facebook.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
